# Direct dependencies only — the packages this project deliberately uses.
# requirements.txt is the complete pinned lockfile (installed with
# `pip install --no-deps` by the Dockerfile and CI) and is currently maintained
# by hand; keep this file in sync when adding/removing a dependency so a full
# lockfile regeneration (`pip-compile requirements.in`) stays possible.

# Core pipeline
crewai
duckdb
polars
pydantic
python-dotenv
pyyaml

# Data-file ingestion (excel engines used by polars at runtime, not imported)
charset-normalizer
openpyxl
python-calamine

# LLM providers / memory
boto3            # crewai's native Bedrock provider imports it lazily
chromadb

# Job queue
celery
redis

# Web app
fastapi
python-multipart  # FastAPI file-upload runtime requirement, not imported
uvicorn[standard]

# Charts
matplotlib

# Tracing (LangSmith over OTel; exporters are the OTLP path OtelSpanProcessor
# uses at runtime)
langsmith
opentelemetry-api
opentelemetry-sdk
opentelemetry-exporter-otlp-proto-grpc
opentelemetry-exporter-otlp-proto-http
opentelemetry-instrumentation-crewai
opentelemetry-instrumentation-openai
wrapt
